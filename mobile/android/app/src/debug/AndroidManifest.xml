<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Device tests only: fire due reminders at a given time, and re-run the boot path. Not in release builds. -->
        <receiver android:name=".DebugReminderReceiver" android:exported="true">
            <intent-filter>
                <action android:name="app.raf.dev.debug.FIRE_DUE" />
                <action android:name="app.raf.dev.debug.RESCHEDULE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

{
  "name": "resume-autofill",
  "description": "网申简历一键填写助手 / Resume Autofill",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm build && playwright test --project=e2e",
    "e2e:headed": "pnpm build && playwright test --project=e2e --headed",
    "visual": "pnpm build && playwright test --project=visual",
    "typecheck": "wxt prepare && tsc --noEmit && tsc --noEmit -p fixtures/synthetic/tsconfig.json",
    "postinstall": "wxt prepare",
    "fixtures:dev": "vite --config fixtures/synthetic/vite.config.ts",
    "fixtures:build": "vite build --config fixtures/synthetic/vite.config.ts",
    "harness:build": "vite build --config tests/drivers/harness/vite.config.ts",
    "test:drivers": "pnpm harness:build && playwright test --project=drivers",
    "fixtures:preview": "vite preview --config fixtures/synthetic/vite.config.ts --port 4173 --strictPort",
    "capture": "node scripts/capture-page.ts",
    "test:captured": "pnpm harness:build && pnpm build && playwright test --project=captured",
    "accuracy:table": "node scripts/accuracy-table.ts",
    "live-check": "pnpm build && node scripts/live-check.ts"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/zcool-kuaile": "^5.3.0",
    "bootstrap-icons": "^1.13.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.3.7",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@wxt-dev/module-react": "^1.2.2",
    "antd": "^5.29.3",
    "dayjs": "^1.11.23",
    "element-plus": "^2.14.7",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "react-select": "^5.10.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vue": "^3.5.44",
    "wxt": "^0.21.5"
  }
}

<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext http is allowed (some campus sites still use it; the address bar warns). Only the system's CAs are
     trusted: certificates the user installed are not, which closes the common interception route. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
